# PHILSURIN — PHP 8.2 + Apache, runs 24/7 on Render/Railway with PC OFF
FROM php:8.2-apache
RUN docker-php-ext-install pdo pdo_mysql pdo_sqlite mysqli && a2enmod rewrite headers && apt-get update && apt-get install -y --no-install-recommends curl sqlite3 && rm -rf /var/lib/apt/lists/*
COPY . /var/www/html/
RUN mkdir -p /var/www/html/data && chown -R www-data:www-data /var/www/html && chmod -R 775 /var/www/html/data
RUN sed -i 's/AllowOverride None/AllowOverride All/g' /etc/apache2/apache2.conf && echo "ServerName localhost" >> /etc/apache2/apache2.conf
COPY start-apache-fixed.sh /usr/local/bin/start-apache.sh
RUN chmod +x /usr/local/bin/start-apache.sh
EXPOSE 80 8080 10000
HEALTHCHECK --interval=30s --timeout=5s --retries=5 CMD curl -f http://localhost:80/health.php || exit 1
CMD ["/usr/local/bin/start-apache.sh"]
